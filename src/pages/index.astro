---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS, STATS } from '../data/products';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const products = Object.values(PRODUCTS);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<div class="badge"><span class="dot"></span>Location intelligence for everyday life</div>
		<h1 class="headline">Products that know <span class="grad">where you are</span> — and what you need there.</h1>
		<p class="subhead">MBA-Labs builds location-aware tools that help people rest better and budget smarter, wherever they happen to be.</p>
		<div class="hero-actions">
			<a class="btn btn-primary btn-lg" href="#products-section">Explore Products</a>
			<a class="btn btn-outline btn-lg" href="#about-section">Learn More</a>
		</div>
	</section>

	<section class="products" id="products-section">
		<h2 class="section-title">Our Products</h2>
		<div class="product-grid">
			{products.map((p) => (
				<a class="product-card" href={`/products/${p.slug}`}>
					<div class="product-icon">
						{p.icon.startsWith('/') ? <img src={p.icon} alt={`${p.name} icon`} /> : p.icon}
					</div>
					<h3>{p.name}</h3>
					<p class="desc">{p.tagline}</p>
					<ul class="feature-list">
						{p.features.map((f) => <li>{f}</li>)}
					</ul>
					<span class="learn-link">Learn about {p.name} →</span>
				</a>
			))}
		</div>

		<div class="stats">
			{STATS.map((s) => (
				<div class="stat-card">
					<div class="num">{s.num}</div>
					<div class="label">{s.label}</div>
				</div>
			))}
		</div>
	</section>

	<section class="about" id="about-section">
		<h2 class="section-title">About MBA-Labs</h2>
		<p>We're a small team, focused on building apps for the real-world  — GeoNap to enable safe, convenient world-wide travel while resting enroute, and Location-Based Budget for managing spending for those that travel to locations consistently throughout the year. No bloat, no unnecessary permissions, just tools that use where you are to make everyday decisions easier.</p>
	</section>
</Layout>
