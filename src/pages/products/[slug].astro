---
import Layout from '../../layouts/Layout.astro';
import { PRODUCTS } from '../../data/products';

// Extracts the substantive markup from the standalone privacy.html doc
// (the single source of truth, maintained in the GeoNap app repo) and
// reshapes it to match the tag/class conventions the dark-themed
// .privacy-body styles on this site expect.
function extractPrivacyHtml(raw: string): string | null {
	const containerMatch = raw.match(/<div class="container">([\s\S]*?)<\/div>\s*<\/body>/);
	let html = containerMatch ? containerMatch[1] : null;
	if (!html) return null;

	const updatedMatch = html.match(/<p class="updated">(Last updated:.*?)<\/p>/);
	const updatedLine = updatedMatch ? `<p class="privacy-updated">${updatedMatch[1]}</p>` : '';
	html = html.replace(/<header>[\s\S]*?<\/header>/, updatedLine);

	html = html.replace('<p class="intro">', '<p>');
	html = html.replace(/<section(?:\s+id="[^"]*")?>/g, '').replace(/<\/section>/g, '');
	html = html.replace(/<h2>/g, '<h3>').replace(/<\/h2>/g, '</h3>');
	html = html.replace(/<footer>\s*([\s\S]*?)\s*<\/footer>/, (_m, inner) => `<p class="privacy-footer">${inner.trim()}</p>`);

	return html.trim();
}

export async function getStaticPaths() {
	const products = { ...PRODUCTS };

	for (const slug of Object.keys(products)) {
		const product = products[slug];
		if (!product.privacyUrl) continue;
		try {
			const res = await fetch(product.privacyUrl);
			if (!res.ok) {
				console.warn(`[privacy] fetch failed (${res.status}) for ${product.privacyUrl}, using bundled fallback`);
				continue;
			}
			const raw = await res.text();
			const extracted = extractPrivacyHtml(raw);
			if (extracted) {
				products[slug] = { ...product, privacy: extracted };
			} else {
				console.warn(`[privacy] could not parse ${product.privacyUrl}, using bundled fallback`);
			}
		} catch (err) {
			console.warn(`[privacy] fetch error for ${product.privacyUrl}, using bundled fallback:`, err);
		}
	}

	return Object.keys(products).map((slug) => ({
		params: { slug },
		props: { product: products[slug] },
	}));
}

const { product: p } = Astro.props;
const deck = p.deck ?? [];
---

<Layout title={`${p.name} — MBA-Labs`} description={p.tagline}>
	<div class="product-view">
		<a class="back-link" href="/#products-section">← Back to all products</a>
		<div class="pv-header">
			<div class="product-icon">
				{p.icon.startsWith('/') ? <img src={p.icon} alt={`${p.name} icon`} /> : p.icon}
			</div>
			<h1>{p.name}</h1>
		</div>
		<p class="pv-tagline">{p.tagline}</p>

		<nav class="pv-subnav">
			<a href="/">Home</a>
			<a href="#pv-sec-description">Description</a>
			<a href="#pv-sec-download">Download</a>
			<a href="#pv-sec-privacy">Privacy Statement</a>
			<a href="#pv-sec-support">Support</a>
		</nav>

		<div class="pv-section" id="pv-sec-description">
			<h2>Description</h2>
			<p>{p.description}</p>
			<ul>
				{p.features.map((f: string) => <li>{f}</li>)}
			</ul>

			{deck.length > 0 && (
				<div class="deck">
					<div class="deck-row">
						<button class="deck-arrow deck-prev" id="deck-prev" aria-label="Previous slide" type="button">‹</button>
						<div class="deck-frame">
							<img id="deck-img" src={deck[0]} alt={`${p.name} slide deck, slide 1 of ${deck.length}`} />
						</div>
						<button class="deck-arrow deck-next" id="deck-next" aria-label="Next slide" type="button">›</button>
					</div>
					<div class="deck-counter" id="deck-counter">1 / {deck.length}</div>
				</div>
			)}
		</div>

		<div class="pv-section" id="pv-sec-download">
			<h2>Download</h2>
			{p.githubUrl ? (
				<>
					<div class="download-row">
						<a class="appstore-badge github-badge" href={p.githubUrl} target="_blank" rel="noopener">
							<span class="appstore-badge-icon">&lt;/&gt;</span>
							<span class="appstore-badge-text"><small>View source on</small><strong>GitHub</strong></span>
						</a>
					</div>
					<p class="download-note">{p.name} isn't on the App Store yet. Clone the repository and build it from source:</p>
					<div class="code-block">git clone {p.githubUrl}.git</div>
				</>
			) : (
				<div class="download-row">
					<a class="appstore-badge" href="#" aria-label="Download on the App Store">
						<span class="appstore-badge-icon"></span>
						<span class="appstore-badge-text"><small>Download on the</small><strong>App Store</strong></span>
					</a>
				</div>
			)}
		</div>

		<div class="pv-section" id="pv-sec-privacy">
			<h2>Privacy Statement</h2>
			<div class="privacy-body" set:html={p.privacy} />
		</div>

		<div class="pv-section" id="pv-sec-support">
			<h2>Support / Contact Us / Feedback / Suggestions</h2>
			<div class="support-grid">
				<div class="support-item">
					<div class="label">Contact Us</div>
					<div class="value"><a href={`mailto:${p.supportEmail}`}>{p.supportEmail}</a></div>
				</div>
				<div class="support-item">
					<div class="label">Response Time</div>
					<div class="value">Within 3 business days</div>
				</div>
			</div>
			<form class="feedback-form" id="feedback-form">
				<label class="label" style="display:block;margin-top:18px;font-size:13px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.04em;">Feedback &amp; Suggestions</label>
				<textarea placeholder="Tell us what you'd like to see, or report an issue..."></textarea>
				<button type="submit" class="btn btn-primary">Send Feedback</button>
				<p class="form-msg">Thanks — your feedback has been received.</p>
			</form>
		</div>
	</div>
</Layout>

<script define:vars={{ deck, productName: p.name }}>
	if (deck.length > 0) {
		let deckIndex = 0;
		const deckImg = document.getElementById('deck-img');
		const deckCounter = document.getElementById('deck-counter');
		const update = () => {
			deckImg.src = deck[deckIndex];
			deckImg.alt = `${productName} slide deck, slide ${deckIndex + 1} of ${deck.length}`;
			deckCounter.textContent = `${deckIndex + 1} / ${deck.length}`;
		};
		document.getElementById('deck-prev').addEventListener('click', () => {
			deckIndex = (deckIndex - 1 + deck.length) % deck.length;
			update();
		});
		document.getElementById('deck-next').addEventListener('click', () => {
			deckIndex = (deckIndex + 1) % deck.length;
			update();
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') { deckIndex = (deckIndex - 1 + deck.length) % deck.length; update(); }
			if (e.key === 'ArrowRight') { deckIndex = (deckIndex + 1) % deck.length; update(); }
		});
	}

	const form = document.getElementById('feedback-form');
	form.addEventListener('submit', (e) => {
		e.preventDefault();
		form.querySelector('.form-msg').style.display = 'block';
		form.querySelector('textarea').value = '';
	});
</script>

<script>
	function pvOffset() {
		const header = document.querySelector('header.nav');
		const subnav = document.querySelector('.pv-subnav');
		const h = header ? header.offsetHeight : 160;
		const s = subnav ? subnav.offsetHeight : 56;
		return h + s + 16;
	}
	function scrollToId(id, smooth) {
		const el = document.getElementById(id);
		if (!el) return;
		const top = el.getBoundingClientRect().top + window.pageYOffset - pvOffset();
		window.scrollTo({ top: Math.max(top, 0), behavior: smooth ? 'smooth' : 'auto' });
	}
	document.querySelectorAll('.pv-subnav a[href^="#"]').forEach((a) => {
		a.addEventListener('click', (e) => {
			e.preventDefault();
			const id = a.getAttribute('href').slice(1);
			history.pushState(null, '', '#' + id);
			scrollToId(id, true);
		});
	});
	if (location.hash) {
		const id = location.hash.slice(1);
		// Let the browser's own (imprecise) jump happen first, then correct it
		// once fonts/images have settled so the heading isn't hidden behind
		// the sticky header + subnav.
		window.addEventListener('load', () => scrollToId(id, false));
		setTimeout(() => scrollToId(id, false), 300);
	}
</script>
